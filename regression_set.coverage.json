{
  "schema": "m4.coverage.regression_set/v1",
  "description": "M4-SUPPLY-COVERAGE-02 coverage/planner regression. expected values are FIXED by the independent basis cited per case (PRD/grid/seed), never backfilled from planner output. real = derives from the real 495 seed or historical grid; controlled = constructed fixture with explicit markers.",
  "version": "v1",
  "created": "2026-10-18",
  "seed_ref": {"path": "/tmp/m4-prd-correction-s1r-r0bwlF/taxonomy.seed.json", "sha256": "a9120f2d7ad6fd4e22d4313942a3dd66cf47b17ff0e42e074bcb7d9443e087ae"},
  "cases": [
    {"id": "C01_dedup_same_url", "kind": "controlled",
     "expect": {"materials": 1, "independent_posts": 1, "verified_operating_entities": 1},
     "basis": "PRD rev4 §2.3 转载同一公告 ≠ 独立来源；同URL不得重复增加覆盖"},
    {"id": "C02_dedup_same_content_hash", "kind": "controlled",
     "expect": {"materials": 1, "independent_posts": 1},
     "basis": "PRD rev4 §2.5 来源覆盖；同内容hash跨URL连通归组"},
    {"id": "C03_roles_not_mixed", "kind": "controlled",
     "expect": {"materials": 3, "independent_posts": 0, "verified_operating_entities": 0},
     "basis": "PRD rev4 §2.3 七类来源严格区分；M2 REVIEW/词面匹配不冒已核商户或独立食客"},
    {"id": "C04_unknown_not_zero", "kind": "controlled",
     "expect": {"cell": "yueA_cantonese_meal", "status": "unknown", "quota_verdict": "unassessed_expected_supply_unknown"},
     "basis": "PRD rev4 §2.5 空材料/历史包无覆盖=unknown，不得冒充无供给；expected_supply unknown 不判达标"},
    {"id": "C05_negation_neighbor", "kind": "controlled",
     "expect": {"verified_operating_entities": 0, "dropped_contains": "negation_or_neighbor_cannot_verify"},
     "basis": "PRD rev4 §2.7 名称像或距离近只给候选不得自动合并；否定/邻店不能硬匹配"},
    {"id": "C06_cross_domain_rejected", "kind": "controlled",
     "expect": {"dropped_contains": "cell_id_not_in_policy"},
     "basis": "PRD-CORRECTION：非food（software）不套美食树；跨域记录不得挂入food policy格"},
    {"id": "C07_ocr_low_confidence", "kind": "controlled",
     "expect": {"materials": 1, "verified_operating_entities": 0, "status": "observed"},
     "basis": "INTEGRATION-03 OCR1 review_required=true 强制 REVIEW；低置信OCR不冒已核商户"},
    {"id": "C08_quota_no_basis_refused", "kind": "controlled",
     "expect": {"plan_blocker": "no_quota_basis"},
     "basis": "04_source_plan 行38 未饱和格不出精选、不硬凑；无配额依据拒绝生成任务"},
    {"id": "C09_pinned_pack_version", "kind": "controlled",
     "expect": {"same_pack_same_task_ids": true, "different_pack_different_task_ids": true},
     "basis": "版本边界：Root 1.1.0 2d7a034e 与 Deuce 1.0.0 f94de00f 不同包不可混称；task_id 绑定pack_ref"},
    {"id": "C10_quota_keeps_material_count", "kind": "controlled",
     "expect": {"materials": 5, "verified_operating_entities": 1, "status": "observed"},
     "basis": "材料数/独立post/已核实体三计数分列；低于配额不削减材料数"},
    {"id": "C11_candidate_target_never_approved", "kind": "controlled",
     "expect": {"cell": "yueA_cantonese_meal", "quota_verdict": "unassessed_expected_supply_unknown", "approved": false},
     "basis": "历史工程目标 Owner 未批准；expected_supply unknown 时即使实体数达候选也不判达标"},
    {"id": "C12_minbei_no_node", "kind": "real",
     "expect": {"cell": "min_minbei", "mapping_status": "pending_review", "coverage_status": "unassessed", "plan_blocker": "blocked_pending_review"},
     "basis": "seed 495 fujian 下仅 fuzhou/minnan/minxi(闽西)，无闽北；闽菜 grid 行61-62 闽北仅1家专门店。不得错挂 minxi"},
    {"id": "C13_fuzhou_three_bands_anchor", "kind": "real",
     "expect": {"cell": "min_fuzhou", "candidate_count": 3, "required_price_bands": ["value", "mid", "high"], "anchor_dish": "佛跳墙"},
     "basis": "闽菜 grid 行30 福州菜≥3 且覆盖高档/中档/平价，佛跳墙锚点在遇外滩系"},
    {"id": "C14_idempotent_plan", "kind": "controlled",
     "expect": {"same_tasks_on_repeat": true},
     "basis": "合同：相同输入幂等重复规划不制造新任务"},
    {"id": "C15_no_budget_still_planned", "kind": "controlled",
     "expect": {"all_status": "PLANNED_NOT_SUBMITTED", "budget_cap": null},
     "basis": "合同：未采用历史目标/无budget 只生成待执行任务；不发outbox/调度/执行"},
    {"id": "C16_budget_truncates", "kind": "controlled",
     "expect": {"truncated": true, "reasons_contains": "budget_exhausted"},
     "basis": "合同：回执 total/truncated/原因/阻断；预算耗尽截断并留原因"},
    {"id": "C17_attempted_failed", "kind": "controlled",
     "expect": {"cell": "yueA_dim_sum", "status": "attempted_failed"},
     "basis": "状态枚举：有尝试且失败、无材料 → attempted_failed（不是无供给）"},
    {"id": "C18_diner_missing_admission", "kind": "controlled",
     "expect": {"independent_posts": 0},
     "basis": "独审：independent_diner=true 但 admission_status 缺失，不计数；unknown 保持未知"},
    {"id": "C19_diner_brand_new_unrecognized", "kind": "controlled",
     "expect": {"independent_posts": 0},
     "basis": "独审：brand_new_unrecognized 属未知身份，无身份依据，不计数独立食客"},
    {"id": "C20_diner_verified_with_identity", "kind": "controlled",
     "expect": {"independent_posts": 1, "verified_operating_entities": 1},
     "basis": "正控：admission_status=verified_independent_diner 且有 identity_evidence_ref 才计1"},
    {"id": "C21_partial_mapping_blocked", "kind": "controlled",
     "expect": {"plan_blocker": "blocked_partial_mapping"},
     "basis": "独审：partial_pending/partial_mapping 不得自动计划，须 blocker"},
    {"id": "C22_fuzhou_no_anchor_below", "kind": "real",
     "expect": {"cell": "min_fuzhou", "verdict": "below_candidate_target", "missing_anchor": true},
     "basis": "闽菜 grid 行30：福州3家3档但无佛跳墙锚点，不得 meets_candidate_target"},
    {"id": "C23_fuzhou_anchor_met", "kind": "real",
     "expect": {"cell": "min_fuzhou", "verdict": "meets_candidate_target"},
     "basis": "闽菜 grid 行30：3家3档且有佛跳墙锚点，候选口径满足（仍非approved）"},
    {"id": "C24_minnan_single_band_below", "kind": "real",
     "expect": {"cell": "min_minnan", "verdict": "below_candidate_target", "bands_ok": false},
     "basis": "闽菜 grid 行43：闽南≥5且≥2档；5家同一档不得 meets_candidate_target"},
    {"id": "C25_approved_gate_full", "kind": "controlled",
     "expect": {"satisfied_met": "met", "unsatisfied_below": "below"},
     "basis": "独审：approved 分支同样校验 count/price_band/anchor 全部约束"},
    {"id": "C26_quote_status_not_verbatim", "kind": "real",
     "expect": {"placeholder_basis": "unknown", "ellipsis_basis": "excerpt", "source_sha_kept": true},
     "basis": "独审：占位/省略 exact_quote 不得冒逐字，保留 source hash 与行范围，标 excerpt/unknown"},
    {"id": "C27_observed_field_actual", "kind": "controlled",
     "expect": {"verified_entities_observed": 0, "deficit": 3},
     "basis": "独审：任务字段 verified_entities_observed 必须是实际观察数，空福州不得显示已核3"},
    {"id": "C28_unknown_verified_null", "kind": "controlled",
     "expect": {"cell": "yueA_shunde", "verified_operating_entities": null, "status": "unknown"},
     "basis": "独审：unknown 未核计数不能用 0 冒事实，应为 null"}
  ]
}
